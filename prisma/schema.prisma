generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations prefer an unpooled connection.
  //
  // Once DATABASE_URL points at Neon's -pooler endpoint, `prisma migrate
  // deploy` can fail against it: the pooler multiplexes sessions, and
  // migrations want a session they own. directUrl lets the app use the
  // pooler while migrations use the direct host.
  //
  // DIRECT_URL MUST BE SET. Prisma resolves env() at schema-validation time
  // and reports P1012 "Environment variable not found" for a missing one -
  // it does not quietly fall back to `url`. Since the Render start command
  // is `prisma migrate deploy && npm start`, an unset DIRECT_URL would fail
  // the deploy, not just the migration. Set it to the un-pooled string; when
  // not using the pooler at all, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id              String        @id @default(uuid())

  /// Public player number, shown in-game and used to add friends.
  ///
  /// The uuid primary key is unusable for that: nobody is going to read out
  /// 36 hex characters to a friend. This is a 10-digit number in the style of
  /// Free Fire / BGMI, unique, and safe to display.
  uid             String        @unique @db.VarChar(10)

  username        String        @unique @db.VarChar(30)
  email           String        @unique @db.VarChar(255)

  /// Null for Google accounts, which have no password of their own.
  passwordHash    String?

  /// Google's stable subject id ('sub'), set when the account signs in with
  /// Google. Unique so two accounts can never claim the same Google user.
  googleId        String?       @unique

  /// False until the player has chosen their own username.
  ///
  /// A Google sign-in has no username, so one is auto-generated and the app
  /// sends the player to the pick-a-username screen while this is false.
  usernameSet     Boolean       @default(false)

  avatarUrl       String?
  level           Int           @default(1)
  xp              Int           @default(0)
  coins           Int           @default(0)
  rankPoints      Int           @default(0)
  accountStatus   AccountStatus @default(ACTIVE)
  emailVerified   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastLogin       DateTime?

  statistics      PlayerStatistics?
  settings        PlayerSettings?
  cosmetics       PlayerCosmetic[]
  sentRequests    FriendRequest[]   @relation("SentRequests")
  receivedRequests FriendRequest[]  @relation("ReceivedRequests")
  friendsAsOne    Friend[]          @relation("FriendOne")
  friendsAsTwo    Friend[]          @relation("FriendTwo")
  matchPlayers    MatchPlayer[]
  notifications   Notification[]
  reportsGiven    Report[]          @relation("Reporter")
  reportsReceived Report[]          @relation("Reported")
  sentMessages    DirectMessage[]   @relation("SentMessages")
  receivedMessages DirectMessage[]  @relation("ReceivedMessages")
  leaderboard     Leaderboard?

  @@index([username])
  @@index([email])
  @@index([uid])
  @@index([googleId])
  @@index([rankPoints])
  @@index([lastLogin])
}

// ─────────────────────────────────────────
// PLAYER STATISTICS
// ─────────────────────────────────────────

model PlayerStatistics {
  id                 String   @id @default(uuid())
  userId             String   @unique
  gamesPlayed        Int      @default(0)
  gamesWon           Int      @default(0)
  gamesLost          Int      @default(0)
  winRate            Float    @default(0)
  longestWinStreak   Int      @default(0)
  currentWinStreak   Int      @default(0)
  cardsPlayed        Int      @default(0)
  cardsDrawn         Int      @default(0)
  totalPlayTime      BigInt   @default(0)

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// PLAYER SETTINGS
// ─────────────────────────────────────────

model PlayerSettings {
  id             String   @id @default(uuid())
  playerId       String   @unique
  language       String   @default("en")
  musicVolume    Int      @default(80)
  soundVolume    Int      @default(80)
  voiceVolume    Int      @default(80)
  pushToTalk     Boolean  @default(false)
  notifications  Boolean  @default(true)
  darkMode       Boolean  @default(true)

  user           User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ─────────────────────────────────────────
// FRIENDS
// ─────────────────────────────────────────

model Friend {
  id        String   @id @default(uuid())
  userOne   String
  userTwo   String
  createdAt DateTime @default(now())

  userOneRef User @relation("FriendOne", fields: [userOne], references: [id], onDelete: Cascade)
  userTwoRef User @relation("FriendTwo", fields: [userTwo], references: [id], onDelete: Cascade)

  @@unique([userOne, userTwo])
  @@index([userOne])
  @@index([userTwo])
}

// ─────────────────────────────────────────
// FRIEND REQUESTS
// ─────────────────────────────────────────

model FriendRequest {
  id         String        @id @default(uuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  sender     User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────
// DIRECT MESSAGES
// ─────────────────────────────────────────

/// A one-to-one message between two friends.
///
/// Previously DMs were relayed over the socket and never stored, so the
/// conversation lived only in the sender's and recipient's app memory: it
/// vanished on restart, and anything sent while the other player was offline
/// was lost outright rather than delivered later.
model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  body       String   @db.VarChar(500)

  /// Set when the recipient has opened the conversation, so the friends list
  /// can show an unread badge.
  readAt     DateTime?

  createdAt  DateTime @default(now())

  sender     User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  /// Reading one conversation is the hot path: both directions, newest first.
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([receiverId, readAt])
}

// ─────────────────────────────────────────
// MATCH HISTORY
// ─────────────────────────────────────────

model Match {
  id          String     @id @default(uuid())
  roomId      String
  winnerId    String?
  duration    Int
  gameMode    GameMode
  totalTurns  Int        @default(0)
  startedAt   DateTime
  endedAt     DateTime

  players     MatchPlayer[]

  @@index([roomId])
  @@index([winnerId])
}

// ─────────────────────────────────────────
// MATCH PLAYERS
// ─────────────────────────────────────────

model MatchPlayer {
  id             String @id @default(uuid())
  matchId        String
  playerId       String
  finalPosition  Int
  cardsRemaining Int    @default(0)
  ratingChange   Int    @default(0)
  xpEarned       Int    @default(0)

  match          Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([playerId])
}

// ─────────────────────────────────────────
// LEADERBOARD
// ─────────────────────────────────────────

model Leaderboard {
  id       String @id @default(uuid())
  playerId String @unique
  rating   Int    @default(1000)
  tier     String @default("BRONZE")
  division String @default("III")
  season   Int    @default(1)

  user     User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([playerId])
}

// ─────────────────────────────────────────
// COSMETICS
// ─────────────────────────────────────────

model PlayerCosmetic {
  id           String        @id @default(uuid())
  playerId     String
  cosmeticType CosmeticType
  cosmeticId   String
  unlockedAt   DateTime      @default(now())

  /// Whether this is the item currently in use for its type. At most one
  /// row per (playerId, cosmeticType) may be true; equipping clears the rest.
  /// Without this a purchase was recorded but never actually applied
  /// anywhere in the game.
  isEquipped   Boolean       @default(false)

  user         User          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Buying the same item twice was previously only prevented in application
  /// code, which leaves a race between two concurrent purchases.
  @@unique([playerId, cosmeticId])
  @@index([playerId])
  @@index([playerId, cosmeticType, isEquipped])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  playerId  String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ─────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedPlayer String
  reason         String
  matchId        String?
  status         ReportStatus @default(PENDING)

  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User         @relation("Reported", fields: [reportedPlayer], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedPlayer])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  BANNED
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GameMode {
  CASUAL
  RANKED
  PRIVATE
  CUSTOM
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum CosmeticType {
  AVATAR
  CARD_BACK
  CARD_THEME
  CARD_ANIMATION
  TABLE_THEME
  PROFILE_BANNER
  BADGE
  TITLE
  EMOTE
  VOICE_PACK
}